/* pages/index/index.wxss */

/* 问候区 */
.greeting {
  padding-top: 24px;
  padding-bottom: 4px;
}

.greeting__text {
  font-family: var(--font-title);
  font-size: 28px;
  font-weight: 600;
  color: var(--ink-black);
  line-height: 1.3;
}

/* 日期区 */
.date-row {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 16px;
}

.date-row__solar {
  font-size: 15px;
  color: var(--ink-black);
  font-weight: 500;
}

.date-row__ganzhi {
  font-size: 14px;
  color: var(--ink-secondary);
  font-weight: 400;
}

/* 区域标题 */
.section-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--ink-black);
  margin-bottom: 12px;
}

/* 骨架屏列表 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: var(--card-gap);
}

.skeleton-card {
  height: 72px;
  border-radius: var(--radius-md);
  width: 100%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48px 0;
  gap: 8px;
}

.empty-state__icon {
  font-size: 48px;
  margin-bottom: 8px;
}

.empty-state__text {
  font-size: 16px;
  color: var(--ink-secondary);
}

.empty-state__hint {
  font-size: 13px;
  color: var(--ink-tertiary);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 22px;
  bottom: 80px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background-color: var(--indigo-deep);
  box-shadow: 0 4px 12px rgba(74, 85, 104, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  transition: transform 0.2s ease;
}

.fab:active {
  transform: scale(0.92);
}

.fab__icon {
  color: #fff;
  font-size: 28px;
  font-weight: 300;
  line-height: 1;
}

{
  "name": "jijie-note",
  "version": "1.0.0",
  "description": "素简 — 融合中国传统文化的个人计划管理与微习惯养成微信小程序",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js"
    ]
  }
}

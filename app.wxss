/* ========================================
 * 素简 — 全局样式 & CSS 变量
 * 参考: openspec/specs/design-tokens.md
 * ======================================== */

/* ---- 色板 ---- */
page {
  --paper-white: #F7F4ED;
  --card-bg: #FCFAF6;
  --ink-black: #2C2C2C;
  --ink-secondary: #6B6560;
  --ink-tertiary: #9C9690;
  --indigo-deep: #4A5568;
  --cinnabar: #C04040;
  --seal-red: #B84040;
  --input-bg: #F2EFE9;
  --gold: #C9943A;

  /* ---- 间距 ---- */
  --page-margin: 22px;
  --card-gap: 10px;
  --card-padding: 16px;

  /* ---- 圆角 ---- */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;

  /* ---- 字体 ---- */
  --font-title: 'Noto Serif SC', serif;
  --font-body: 'Noto Sans SC', 'PingFang SC', sans-serif;

  /* ---- 阴影 ---- */
  --shadow-inner: inset 0 1px 2px rgba(44,44,44,0.04);

  /* 页面基础样式 */
  background-color: var(--paper-white);
  font-family: var(--font-body);
  color: var(--ink-black);
  font-size: 15px;
  line-height: 1.5;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ---- 通用工具类 ---- */

/* 安全边距容器 */
.page-container {
  padding: 0 var(--page-margin);
  box-sizing: border-box;
}

/* 卡片基类 */
.card {
  background-color: var(--card-bg);
  border-radius: var(--radius-md);
  padding: var(--card-padding);
  box-shadow: var(--shadow-inner);
  margin-bottom: var(--card-gap);
}

/* 弹性缓出动画 */
.anim-spring {
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 淡入动画 */
.anim-fade-in {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 印章弹出动画 */
@keyframes stampPop {
  0%   { transform: scale(2.5) rotate(18deg); opacity: 0; }
  25%  { transform: scale(0.95); opacity: 0.9; }
  42%  { transform: scale(1.05); }
  100% { transform: scale(1) rotate(18deg); opacity: 0.85; }
}

.stamp-anim {
  animation: stampPop 0.6s ease-out forwards;
}

/* 骨架屏脉冲 */
@keyframes skeletonPulse {
  0%   { opacity: 0.4; }
  50%  { opacity: 0.8; }
  100% { opacity: 0.4; }
}

.skeleton {
  background-color: var(--input-bg);
  border-radius: var(--radius-sm);
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

/* 文字截断 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 优先级标记 */
.priority-dot--high { color: var(--cinnabar); }
.priority-dot--mid  { color: var(--indigo-deep); }
.priority-dot--low  { color: var(--ink-tertiary); }

/* 已完成任务样式 */
.task-done {
  opacity: 0.6;
}

.task-done .task-title--done {
  text-decoration: line-through;
  text-decoration-color: var(--cinnabar);
}

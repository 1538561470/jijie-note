<!-- components/task-card/task-card.wxml -->
<!-- 参考: openspec/specs/task-management.md §5-6, design.md §4.3 -->

<view
  class="task-card {{completed ? 'task-card--done' : ''}}"
  data-id="{{task.id}}"
  bind:tap="onToggleComplete"
  bind:longpress="onShowActions"
>
  <view class="task-card__check {{completed ? 'task-card__check--checked' : ''}}">
    <text class="task-card__check-icon">{{completed ? '✓' : '○'}}</text>
  </view>
  <view class="task-card__body">
    <text class="task-card__title {{completed ? 'task-card__title--done' : ''}}">
      {{task.title}}
    </text>
    <view class="task-card__meta" wx:if="{{task.note || task.priority}}">
      <text class="priority-dot priority-dot--{{task.priority}}">●</text>
      <text class="task-card__note text-ellipsis" wx:if="{{task.note}}">{{task.note}}</text>
    </view>
  </view>
  <view class="task-card__stamp stamp-anim" wx:if="{{completed}}">完</view>
</view>

/* components/toast/index.wxss */

.toast {
  position: fixed;
  top: 80px;
  left: 50%;
  transform: translateX(-50%) translateY(-20px);
  background-color: rgba(44, 44, 44, 0.9);
  border-radius: 20px;
  padding: 10px 24px;
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s ease;
  pointer-events: none;
  white-space: nowrap;
}

.toast--show {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.toast__text {
  color: #fff;
  font-size: 14px;
}
